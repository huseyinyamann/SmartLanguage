// ÖRNEK DOSYA — bunu `Secrets.xcconfig` adıyla kopyalayıp doldur.
// Gerçek dosya git'e gönderilmez.
//
// Değeri ios/Runner/GoogleService-Info.plist içindeki REVERSED_CLIENT_ID
// anahtarından al. Dosya yoksa Google ile giriş iOS'ta geri dönüş yapamaz.
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.000000000000-xxxxxxxxxxxxxxxx
