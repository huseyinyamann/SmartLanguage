// ÖRNEK DOSYA — gerçek `lib/firebase_options.dart` git'e gönderilmez.
//
// Kendi Firebase projeni bağlamak için:
//   dart pub global activate flutterfire_cli
//   flutterfire configure
// komutu bu dosyanın gerçeğini (ve google-services.json /
// GoogleService-Info.plist dosyalarını) senin proje kimliklerinle üretir.
//
// Elle kurmak istersen bu dosyayı `firebase_options.dart` adıyla kopyalayıp
// aşağıdaki alanları Firebase Console → Proje ayarları'ndan doldur.
// ignore_for_file: type=lint
import 'package:firebase_core/firebase_core.dart' show FirebaseOptions;
import 'package:flutter/foundation.dart'
    show defaultTargetPlatform, kIsWeb, TargetPlatform;

/// Default [FirebaseOptions] for use with your Firebase apps.
class DefaultFirebaseOptions {
  static FirebaseOptions get currentPlatform {
    if (kIsWeb) {
      throw UnsupportedError(
        'DefaultFirebaseOptions have not been configured for web - '
        'you can reconfigure this by running the FlutterFire CLI again.',
      );
    }
    switch (defaultTargetPlatform) {
      case TargetPlatform.android:
        return android;
      case TargetPlatform.iOS:
        return ios;
      default:
        throw UnsupportedError(
          'DefaultFirebaseOptions are not supported for this platform.',
        );
    }
  }

  static const FirebaseOptions android = FirebaseOptions(
    apiKey: 'YOUR_ANDROID_API_KEY',
    appId: '1:000000000000:android:0000000000000000000000',
    messagingSenderId: '000000000000',
    projectId: 'your-project-id',
    storageBucket: 'your-project-id.firebasestorage.app',
  );

  static const FirebaseOptions ios = FirebaseOptions(
    apiKey: 'YOUR_IOS_API_KEY',
    appId: '1:000000000000:ios:0000000000000000000000',
    messagingSenderId: '000000000000',
    projectId: 'your-project-id',
    storageBucket: 'your-project-id.firebasestorage.app',
    androidClientId: '000000000000-xxxxxxxx.apps.googleusercontent.com',
    iosClientId: '000000000000-xxxxxxxx.apps.googleusercontent.com',
    iosBundleId: 'com.example.app',
  );
}
